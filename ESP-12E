// ---------- Helper functions ----------
void beep(int times, int onMs) {
  for (int i = 0; i < times; i++) {
    digitalWrite(BUZZER_PIN, HIGH);
    delay(onMs);
    digitalWrite(BUZZER_PIN, LOW);
    delay(80);
  }
}

// Remove characters that break our packet format and cut to max bytes
String clean(String s, int maxBytes) {
  s.replace("|", " ");
  s.replace("\r", " ");
  s.replace("\n", " ");
  s.replace("\t", " ");
  s.trim();
  if ((int)s.length() > maxBytes) {
    int cut = maxBytes;
    // do not cut in the middle of a Hindi/Kannada (UTF-8) letter
    while (cut > 0 && (((uint8_t)s[cut]) & 0xC0) == 0x80) cut--;
    s = s.substring(0, cut);
  }
  return s;
}

bool alreadySeen(uint32_t id) {
  for (int i = 0; i < SEEN_SIZE; i++) {
    if (seenIDs[i] == id) return true;
  }
  return false;
}

void rememberID(uint32_t id) {
  seenIDs[seenPos] = id;
  seenPos = (seenPos + 1) % SEEN_SIZE;
}

void addMessage(const String &from, const String &text, bool sos, bool mine, int rssi) {
  Msg &m = msgs[msgSeq % MAX_MSG];
  m.from = from;
  m.text = text;
  m.sos = sos;
  m.mine = mine;
  m.rssi = rssi;
  msgSeq++;
}

// Packet format:  ID|FROM|TO|TTL|TYPE|TEXT      (TYPE: M = message, S = SOS)
String buildPacket(uint32_t id, const String &from, const String &to, int ttl, const char *type, const String &text) {
  char idb[9];
  sprintf(idb, "%08X", (unsigned int)id);
  return String(idb) + "|" + from + "|" + to + "|" + String(ttl) + "|" + type + "|" + text;
}

void transmit(const String &pkt) {
  if (!loraOk) return;
  LoRa.beginPacket();
  LoRa.print(pkt);
  LoRa.endPacket();
}

void queuePacket(const String &pkt, unsigned long delayMs) {
  for (int i = 0; i < RELAY_Q; i++) {
    if (!relayQ[i].used) {
      relayQ[i].pkt = pkt;
      relayQ[i].due = millis() + delayMs;
      relayQ[i].used = true;
      return;
    }
  }
  // queue full: drop
}

void sendDueRelays() {
  for (int i = 0; i < RELAY_Q; i++) {
    if (relayQ[i].used && (long)(millis() - relayQ[i].due) >= 0) {
      transmit(relayQ[i].pkt);
      relayQ[i].used = false;
    }
  }
}

// Send a new message from this device
void sendMessage(String name, String to, String text, bool sos) {
  name = clean(name, 16);
  if (name.length() == 0) name = "User";
  to = clean(to, 8);
  to.toUpperCase();
  if (to.length() == 0 || sos) to = "ALL";
  text = clean(text, MAX_TEXT);
  if (text.length() == 0) return;

  String from = name + "@" + nodeId;
  uint32_t id = RANDOM_REG32;   // hardware random number
  if (id == 0) id = 1;
  rememberID(id);

  String pkt = buildPacket(id, from, to, START_TTL, sos ? "S" : "M", text);
  transmit(pkt);
  if (sos) queuePacket(pkt, 3000);   // SOS is sent a second time after 3 seconds

  addMessage(from, text, sos, true, 0);
  Serial.println("SENT  -> " + pkt);
}

// ---------- Receive from LoRa ----------
void receiveLoRa() {
  if (!loraOk) return;
  int size = LoRa.parsePacket();
  if (size <= 0) return;

  String msg = "";
  while (LoRa.available()) msg += (char)LoRa.read();
  int rssi = LoRa.packetRssi();

  int idx[5];
  int p = -1;
  for (int i = 0; i < 5; i++) {
    p = msg.indexOf('|', p + 1);
    if (p < 0) return;            // not our packet
    idx[i] = p;
  }

  uint32_t id = strtoul(msg.substring(0, idx[0]).c_str(), NULL, 16);
  String from = msg.substring(idx[0] + 1, idx[1]);
  String to   = msg.substring(idx[1] + 1, idx[2]);
  int ttl     = msg.substring(idx[2] + 1, idx[3]).toInt();
  String type = msg.substring(idx[3] + 1, idx[4]);
  String text = msg.substring(idx[4] + 1);

  if (id == 0 || ttl < 1 || ttl > 10) return;
  if (alreadySeen(id)) return;       // already handled -> stops loops
  rememberID(id);

  Serial.println("GOT   <- " + msg + "  (RSSI " + String(rssi) + ")");

  bool sos = (type == "S");
  bool forMe = (to == "ALL" || to == nodeId);

  if (forMe) {
    addMessage(from, text, sos, false, rssi);
    if (sos) beep(3, 200); else beep(1, 80);
  }

  // Pass it forward so other devices can get it (not needed if it was only for me)
  if (ttl > 1 && to != nodeId) {
    String pkt = buildPacket(id, from, to, ttl - 1, sos ? "S" : "M", text);
    queuePacket(pkt, random(300, 1500));   // random wait so devices do not collide
  }
}

// ---------- Web handlers ----------
void handleRoot() {
  server.send_P(200, "text/html", PAGE);
}

void handleSend() {
  String text = clean(server.arg("text"), MAX_TEXT);
  if (text.length() == 0) {
    server.send(400, "text/plain", "Empty");
    return;
  }
  bool sos = (server.arg("type") == "S");
  sendMessage(server.arg("nm"), server.arg("to"), text, sos);
  server.send(200, "text/plain", "Sent");
}

// Reply format:  first line  = NODEID <tab> latestNumber
//                next lines  = number <tab> M/S <tab> mine(1/0) <tab> rssi <tab> from <tab> text
void handlePoll() {
  long since = server.arg("since").toInt();
  if (since < 0 || since > (long)msgSeq) since = 0;
  long start = since + 1;
  long oldest = (long)msgSeq - MAX_MSG + 1;
  if (start < oldest) start = oldest;

  String out = nodeId + "\t" + String(msgSeq) + "\t" + (loraOk ? "1" : "0") + "\n";
  for (long s = start; s <= (long)msgSeq; s++) {
    Msg &m = msgs[(s - 1) % MAX_MSG];
    out += String(s) + "\t" + (m.sos ? "S" : "M") + "\t" + (m.mine ? "1" : "0") + "\t" +
           String(m.rssi) + "\t" + m.from + "\t" + m.text + "\n";
  }
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/plain", out);
}

void handleNotFound() {
  server.send(404, "text/plain", "Open http://192.168.4.1");
}

// ---------- SOS push button ----------
void checkButton() {
  static unsigned long lastPress = 0;
  if (digitalRead(SOS_BTN_PIN) == LOW && millis() - lastPress > 5000) {
    lastPress = millis();
    sendMessage("Node", "ALL", "SOS! Need help", true);
    beep(2, 150);
  }
}

// ---------- Main ----------
void setup() {
  Serial.begin(115200);
  delay(300);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  pinMode(SOS_BTN_PIN, INPUT_PULLUP);

  // Unique ID from the chip (last 2 bytes of MAC)
  char b[5];
  sprintf(b, "%04X", (unsigned int)(ESP.getChipId() & 0xFFFF));
  nodeId = String(b);

  // LoRa
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);
  if (LoRa.begin(LORA_FREQ)) {
    LoRa.setSpreadingFactor(9);       // 7 = faster, 12 = longest range
    LoRa.setSignalBandwidth(125E3);
    LoRa.setCodingRate4(5);
    LoRa.setSyncWord(0xF3);
    LoRa.enableCrc();
    LoRa.setTxPower(17);
    loraOk = true;
    Serial.println("LoRa OK");
  } else {
    // WiFi will still start, so you can see the problem on the phone
    Serial.println("LoRa FAILED. Check wiring, 3.3V and antenna.");
    beep(3, 300);
  }

  // WiFi hotspot (open, so anyone nearby can join in an emergency)
  String ssid = "DisasterNet-" + nodeId;
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid.c_str());

  server.on("/", handleRoot);
  server.on("/send", handleSend);
  server.on("/poll", handlePoll);
  server.onNotFound(handleNotFound);
  server.begin();

  Serial.println("=================================");
  Serial.println("Node ID : " + nodeId);
  Serial.println("WiFi    : " + ssid);
  Serial.println("Open    : http://" + WiFi.softAPIP().toString());
  Serial.println("=================================");
  beep(1, 200);
}

void loop() {
  server.handleClient();
  receiveLoRa();
  sendDueRelays();
  checkButton();
  delay(2);
}
