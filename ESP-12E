#include <SPI.h>
#include <LoRa.h>
#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

// ---------- Pins for NodeMCU V3 (GPIO numbers) ----------
// Ra-02 SCK  -> D5 (GPIO14)   hardware SPI, fixed
// Ra-02 MISO -> D6 (GPIO12)   hardware SPI, fixed
// Ra-02 MOSI -> D7 (GPIO13)   hardware SPI, fixed
#define LORA_SS    15   // Ra-02 NSS  -> D8
#define LORA_RST   16   // Ra-02 RST  -> D0
#define LORA_DIO0  4    // Ra-02 DIO0 -> D2

// ---------- Optional parts (nothing happens if not connected) ----------
#define BUZZER_PIN   5   // D1: buzzer + to D1, - to GND
#define SOS_BTN_PIN  0   // D3: push button between D3 and GND (the onboard FLASH button also works)

// ---------- Settings (must be the SAME on all devices) ----------
#define LORA_FREQ   433E6   // Ra-02 = 433 MHz. Change only if your module is different
#define START_TTL   4       // message can jump 4 times
#define MAX_TEXT    160     // max bytes of message text
#define MAX_MSG     20      // messages kept in memory (ESP8266 has less RAM)
#define SEEN_SIZE   40      // message IDs remembered (to stop loops)
#define RELAY_Q     6       // messages waiting to be forwarded

ESP8266WebServer server(80);
String nodeId;
bool loraOk = false;   // becomes true when the LoRa module starts correctly

// ---------- Message storage ----------
struct Msg {
  String from;
  String text;
  bool sos;
  bool mine;
  int rssi;
};
Msg msgs[MAX_MSG];
uint32_t msgSeq = 0;

uint32_t seenIDs[SEEN_SIZE];
int seenPos = 0;

struct Relay {
  String pkt;
  unsigned long due;
  bool used;
};
Relay relayQ[RELAY_Q];

